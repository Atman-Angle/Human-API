{
  "name": "human-api-evidence-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "esbuild apps/api/src/server.ts --bundle --platform=node --format=esm --outfile=dist/server.js",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build",
    "start": "tsx apps/api/src/server.ts",
    "spike:golden": "tsx scripts/run-golden-live.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@types/node": "^24.3.0",
    "esbuild": "^0.25.9",
    "eslint": "^9.35.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0",
    "vitest": "^3.2.4"
  }
}
