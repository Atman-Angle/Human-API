{
  "name": "human-api-evidence-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev:web": "npm run dev --workspace @human-api/web",
    "dev:api": "tsx apps/api/src/server.ts",
    "lint": "npm run lint:api && npm run lint:web",
    "lint:api": "eslint .",
    "lint:web": "npm run lint --workspace @human-api/web",
    "typecheck": "npm run typecheck:api && npm run typecheck:web",
    "typecheck:api": "tsc --noEmit",
    "typecheck:web": "npm run typecheck --workspace @human-api/web",
    "test": "vitest run",
    "build": "npm run build:api && npm run build:web",
    "build:api": "esbuild apps/api/src/server.ts --bundle --platform=node --format=esm --outfile=dist/server.js",
    "build:web": "npm run build --workspace @human-api/web",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build",
    "start": "tsx apps/api/src/server.ts",
    "spike:golden": "tsx scripts/run-golden-live.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@types/node": "^24.3.0",
    "esbuild": "^0.25.9",
    "eslint": "^9.35.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0",
    "vitest": "^3.2.4"
  }
}
