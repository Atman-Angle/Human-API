# Human Gateway local configuration template.
# Copy to .env and replace placeholders. Never commit real secrets.

# Zhihu official API Access Secret used by hot list/search/user profile adapters.
ZHIHU_ACCESS_SECRET=replace_with_zhihu_access_secret

# Zhihu OAuth application credentials.
ZHIHU_APP_ID=200
ZHIHU_APP_KEY=replace_with_full_oauth_app_key
# Must match a redirect URI registered in the Zhihu OAuth application.
ZHIHU_REDIRECT_URI=http://localhost:3000/auth/zhihu/callback

# Optional Zhihu community write API credentials, if that adapter is enabled.
ZHIHU_APP_SECRET=replace_with_zhihu_app_secret

# Optional LLM configuration for discussion organization.
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
LLM_TIMEOUT_MS=90000